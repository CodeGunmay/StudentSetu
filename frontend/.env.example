# StudentSetu — build-time configuration
#
# Copy to `.env.local` (Vite reads .env, .env.local, .env.development.local …).
# These are compiled INTO the bundle: change one here and you must restart the
# dev server or rebuild for `dist/`. A running site cannot switch them.

# ── which data source the app uses ───────────────────────────────────────────
# true  (default) -> the in-memory mock campus in src/api/seed.js
# false          -> the C++ server at VITE_API_BASE, no fallback either way
VITE_USE_MOCK=true

# ── where the C++ server lives (real mode only) ──────────────────────────────
# LOCAL DEVELOPMENT: the C++ server listens on this port, and its own PORT
# variable decides it — 8080 unless the server was started with PORT=…
# The server sends CORS on every response (Allow-Origin: *, Content-Type and
# Authorization allowed, OPTIONS answered with 204), so the dev server on :5173
# may call it directly. There is no /api proxy here on purpose, and the app never
# sends credentials/cookies — that is what makes Allow-Origin: * legal.
VITE_API_BASE=http://localhost:8080

# DEPLOYMENT: localhost is meaningless on a visitor's machine, and the C++ server
# is NOT hosted yet — there is no real address to put here. Until there is one,
# netlify.toml builds the demo (VITE_USE_MOCK=true) and a real-mode build for a host
# like Netlify is refused by `vite build`, rather than shipping an app whose every
# call fails in the Network tab. When the server has an address, it must be https
# (or same-origin, see below) — then set VITE_USE_MOCK=false in the same commit.
#   VITE_API_BASE=https://YOUR-API-HOST      ← replace before deploying
#
# Same origin (nginx/Caddy serving dist/ and proxying /api to the API): leave
# VITE_API_BASE empty and set VITE_API_SAME_ORIGIN=1 so the build guard knows the
# empty value is deliberate. There is no same-origin /api on Netlify.
#   VITE_API_BASE=
#   VITE_API_SAME_ORIGIN=1

# ── demo affordances: the dev OTP prefill, the demo password hint ────────────
# Only ever honoured in mock mode, and never in a production build unless you set
# it explicitly. Real credentials are never shown or stored either way.
# VITE_SHOW_DEV_OTP is the same switch under the name the API team uses: either
# one turns hints on, either one turns them off, so netlify.toml pins both.
VITE_DEMO_HINTS=false
VITE_SHOW_DEV_OTP=false

# ── how often an open Activity/Skills screen re-reads the server (ms) ────────
# 0 disables polling; the focus/visibility refresh still runs. Default: 15000 in
# real mode, off in mock mode (there is nobody else to hear from).
VITE_POLL_MS=15000

# ── the key the session token is kept under ─────────────────────────────────
# The ONLY thing written to localStorage apart from the theme and the intro flag:
# no passwords, no OTP codes, no response bodies.
VITE_TOKEN_KEY=setu.token
